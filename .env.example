# Optional phone alerts. Nothing is sent unless enabled when starting a live session.
# The application does not load this file automatically. See docs/NOTIFICATIONS.md.
CARWATCH_NTFY_SERVER=https://notify.example.invalid
CARWATCH_NTFY_TOPIC=carwatch-private
CARWATCH_NTFY_TOKEN=
# Set to 1 only after configuring private read/write access on the topic.
CARWATCH_NTFY_PRIVATE=0
